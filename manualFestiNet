<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FestiNet · Manuales</title>
<meta name="description" content="Manuales de usuario, instalación y administración de la plataforma FestiNet.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎶</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F6F3FF; --surface:#FFFFFF; --ink:#17133A; --muted:#5B5780; --line:#DDD6F5;
  --violet:#5B3CF0; --amber:#FFB320; --code-bg:#17133A; --code-ink:#EDE9FF;
  --hero-from:#17133A; --hero-to:#3A1F8F;
}
@media (prefers-color-scheme:dark){
  :root{--bg:#0F0C27; --surface:#1A1640; --ink:#F0ECFF; --muted:#A9A3D4; --line:#2E2866;
  --violet:#9B86FF; --code-bg:#0A0819; --hero-from:#0F0C27; --hero-to:#2B1773}
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Figtree,system-ui,sans-serif;line-height:1.65;font-size:17px}
h1,h2,h3{font-family:'Bricolage Grotesque',Figtree,sans-serif;line-height:1.1;margin:0}
a{color:var(--violet)}
:focus-visible{outline:3px solid var(--amber);outline-offset:3px;border-radius:6px}

/* Hero: stage spotlights */
.hero{position:relative;overflow:hidden;color:#fff;padding:72px 24px 64px;
  background:linear-gradient(160deg,var(--hero-from),var(--hero-to))}
.hero::before,.hero::after{content:"";position:absolute;top:-40%;width:42%;height:150%;
  background:linear-gradient(180deg,rgba(255,179,32,.35),transparent 70%);
  clip-path:polygon(45% 0,55% 0,100% 100%,0 100%);transform-origin:50% 0}
.hero::before{left:6%;transform:rotate(-14deg);animation:sweepL 9s ease-in-out infinite alternate}
.hero::after{right:6%;transform:rotate(14deg);animation:sweepR 9s ease-in-out infinite alternate;opacity:.8}
@keyframes sweepL{to{transform:rotate(8deg)}}
@keyframes sweepR{to{transform:rotate(-8deg)}}
.hero-in{position:relative;max-width:1000px;margin:auto}
.hero h1{font-size:clamp(3.4rem,11vw,7.5rem);font-weight:800;letter-spacing:-.03em}
.hero p{max-width:34em;font-size:1.2rem;color:#D9D3FF;margin:18px 0 0}
.badge{display:inline-block;background:var(--amber);color:#17133A;font-weight:700;font-size:.85rem;padding:5px 12px;border-radius:99px;margin-bottom:18px}

/* Tabs */
.tabs{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line)}
.tabs-in{max-width:1000px;margin:auto;display:flex;gap:8px;padding:12px 24px;overflow-x:auto}
.tab{flex:1 0 auto;cursor:pointer;border:2px solid var(--line);background:var(--surface);color:var(--ink);
  font:700 1rem Figtree,sans-serif;padding:12px 20px;border-radius:12px;text-align:left;transition:.15s}
.tab small{display:block;font-weight:400;color:var(--muted);font-size:.82rem}
.tab:hover{border-color:var(--violet)}
.tab[aria-selected=true]{background:var(--violet);border-color:var(--violet);color:#fff}
.tab[aria-selected=true] small{color:#E5DEFF}

main{max-width:1000px;margin:auto;padding:40px 24px 72px}
.panel[hidden]{display:none}
.panel>h2{font-size:clamp(2rem,5vw,3.2rem);margin-bottom:10px;letter-spacing:-.02em}
.lead{color:var(--muted);max-width:40em;margin:0 0 32px;font-size:1.1rem}
h3{font-size:1.5rem;margin:40px 0 12px}
section{margin-bottom:8px}
p{max-width:44em}

/* Content blocks */
.steps{list-style:none;counter-reset:s;padding:0;margin:0;display:grid;gap:10px}
.steps li{counter-increment:s;display:flex;gap:14px;align-items:flex-start;background:var(--surface);
  border:1px solid var(--line);border-radius:12px;padding:14px 16px}
.steps li::before{content:counter(s);flex:none;width:30px;height:30px;border-radius:50%;background:var(--violet);
  color:#fff;font-weight:700;display:grid;place-items:center;font-size:.95rem}
.steps ul{margin:6px 0 0;padding-left:18px;color:var(--muted)}
.roles{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.role{background:var(--surface);border:1px solid var(--line);border-top:5px solid var(--violet);border-radius:12px;padding:18px 20px}
.role:nth-child(2){border-top-color:var(--amber)}
.role:nth-child(3){border-top-color:#E5486B}
.role h4{margin:0 0 8px;font:800 1.2rem 'Bricolage Grotesque',sans-serif}
.role ul,.check{margin:0;padding-left:20px}
.check{list-style:none;padding:0;display:grid;gap:8px}
.check li{padding-left:30px;position:relative}
.check li::before{content:"✓";position:absolute;left:0;top:1px;width:22px;height:22px;border-radius:50%;
  background:var(--amber);color:#17133A;font-weight:800;font-size:.8rem;display:grid;place-items:center}
.reqs{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
.box{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:18px 20px}
.box h4{margin:0 0 8px;font:800 1.1rem 'Bricolage Grotesque',sans-serif}
.box ul{margin:0;padding-left:20px}
.note{background:var(--surface);border-left:5px solid var(--amber);border-radius:0 12px 12px 0;padding:14px 18px;max-width:44em}

/* Code */
.code{position:relative;margin:12px 0 20px}
pre{margin:0;background:var(--code-bg);color:var(--code-ink);padding:16px 70px 16px 18px;border-radius:12px;overflow-x:auto;
  font:500 .92rem/1.6 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.copy{position:absolute;top:10px;right:10px;cursor:pointer;border:0;background:rgba(255,255,255,.14);color:#fff;
  font:700 .78rem Figtree,sans-serif;padding:6px 10px;border-radius:8px}
.copy:hover{background:rgba(255,255,255,.28)}
code.i{background:var(--surface);border:1px solid var(--line);padding:2px 7px;border-radius:6px;font-size:.9em}

/* Table */
.tw{overflow-x:auto}
table{border-collapse:collapse;width:100%;max-width:520px;background:var(--surface);border-radius:12px;overflow:hidden}
th,td{text-align:left;padding:12px 16px;border-bottom:1px solid var(--line)}
th{background:var(--violet);color:#fff}
tr:last-child td{border-bottom:0}

footer{border-top:1px solid var(--line);padding:28px 24px;text-align:center;color:var(--muted);font-size:.92rem}
@media (prefers-reduced-motion:reduce){.hero::before,.hero::after{animation:none}html{scroll-behavior:auto}}
</style>
</head>
<body>

<header class="hero">
  <div class="hero-in">
    <span class="badge">Documentación · Proyecto ASIR</span>
    <h1>FestiNet</h1>
    <p>La plataforma que conecta artistas y locales para organizar eventos y actuaciones. Aquí tienes los tres manuales para usarla, instalarla y administrarla.</p>
  </div>
</header>

<nav class="tabs" aria-label="Manuales">
  <div class="tabs-in" role="tablist">
    <button class="tab" role="tab" id="t-usuario" aria-controls="usuario" aria-selected="true">Manual de usuario<small>Artistas, locales y administradores</small></button>
    <button class="tab" role="tab" id="t-instalacion" aria-controls="instalacion" aria-selected="false">Manual de instalación<small>Despliegue en Ubuntu Server</small></button>
    <button class="tab" role="tab" id="t-administracion" aria-controls="administracion" aria-selected="false">Configuración y administración<small>Seguridad, copias y soporte</small></button>
  </div>
</nav>

<main>

<!-- MANUAL 1 -->
<div class="panel" id="usuario" role="tabpanel" aria-labelledby="t-usuario">
  <h2>Manual de usuario</h2>
  <p class="lead">Para los usuarios finales de FestiNet: explica el funcionamiento básico de la aplicación y las acciones principales de artistas, locales y administradores.</p>

  <section>
    <h3>Registro de usuarios</h3>
    <ol class="steps">
      <li><div>Accede a la página principal de FestiNet.</div></li>
      <li><div>Selecciona el tipo de usuario: <strong>Artista</strong> o <strong>Local</strong>.</div></li>
      <li><div>Completa el formulario de registro.</div></li>
      <li><div>Introduce una contraseña que cumpla los requisitos de seguridad.</div></li>
      <li><div>Confirma el alta en la plataforma.</div></li>
    </ol>
  </section>

  <section>
    <h3>Inicio de sesión</h3>
    <ol class="steps">
      <li><div>Introduce tu correo electrónico y tu contraseña.</div></li>
      <li><div>Pulsa «Iniciar sesión».</div></li>
      <li><div>Accederás al panel que corresponde a tu rol.</div></li>
    </ol>
  </section>

  <section>
    <h3>Qué puede hacer cada rol</h3>
    <div class="roles">
      <div class="role"><h4>Artista</h4><ul>
        <li>Consultar eventos disponibles.</li><li>Solicitar participación en eventos.</li>
        <li>Gestionar su perfil.</li><li>Consultar información de locales.</li>
        <li>Recibir respuestas de locales interesados.</li></ul></div>
      <div class="role"><h4>Local</h4><ul>
        <li>Crear eventos.</li><li>Editar eventos.</li><li>Gestionar actuaciones.</li>
        <li>Consultar perfiles de artistas.</li><li>Contactar con artistas para contrataciones.</li></ul></div>
      <div class="role"><h4>Administrador</h4><ul>
        <li>Supervisar el funcionamiento de la plataforma.</li><li>Gestionar usuarios.</li>
        <li>Acceder al panel de administración.</li><li>Supervisar el servidor mediante Webmin.</li></ul></div>
    </div>
  </section>

  <section>
    <h3>Cierre de sesión</h3>
    <p>Pulsa el botón «Cerrar sesión». El sistema te redirigirá automáticamente a la página principal.</p>
  </section>
</div>

<!-- MANUAL 2 -->
<div class="panel" id="instalacion" role="tabpanel" aria-labelledby="t-instalacion" hidden>
  <h2>Manual de instalación</h2>
  <p class="lead">Procedimiento seguido para desplegar FestiNet sobre un servidor Ubuntu Server.</p>

  <section>
    <h3>Requisitos previos</h3>
    <div class="reqs">
      <div class="box"><h4>Hardware mínimo</h4><ul><li>Procesador de 4 núcleos</li><li>8 GB de memoria RAM</li><li>50 GB de almacenamiento SSD</li><li>Conexión a Internet</li></ul></div>
      <div class="box"><h4>Software necesario</h4><ul><li>Ubuntu Server</li><li>Apache</li><li>PHP</li><li>PostgreSQL</li><li>Git</li><li>Webmin</li></ul></div>
    </div>
  </section>

  <section>
    <h3>Actualización del sistema</h3>
    <div class="code"><pre>sudo apt update
sudo apt upgrade -y</pre><button class="copy">Copiar</button></div>
  </section>

  <section>
    <h3>Instalación de Apache, PHP y PostgreSQL</h3>
    <div class="code"><pre>sudo apt install apache2 -y
sudo apt install php -y
sudo apt install postgresql postgresql-contrib -y</pre><button class="copy">Copiar</button></div>
  </section>

  <section>
    <h3>Instalación de Webmin</h3>
    <p>Añade el repositorio oficial de Webmin e instálalo para administrar el servidor de forma gráfica.</p>
  </section>

  <section>
    <h3>Despliegue de la aplicación</h3>
    <p>Obtén el código fuente desde GitHub con Git y copia los archivos al directorio correspondiente de Apache.</p>
    <div class="code"><pre>git clone URL_DEL_REPOSITORIO</pre><button class="copy">Copiar</button></div>
  </section>

  <section>
    <h3>Importación de la base de datos</h3>
    <p>Importa el archivo SQL generado durante el desarrollo y crea el usuario administrador que necesita la aplicación.</p>
    <div class="code"><pre>psql -U postgres -d festinet &lt; festinet.sql</pre><button class="copy">Copiar</button></div>
  </section>

  <section>
    <h3>Reinicio de servicios</h3>
    <div class="code"><pre>sudo systemctl restart apache2
sudo systemctl restart postgresql</pre><button class="copy">Copiar</button></div>
  </section>

  <section>
    <h3>Verificación de funcionamiento</h3>
    <ul class="check">
      <li>La página web carga correctamente.</li>
      <li>Hay conexión con PostgreSQL.</li>
      <li>El inicio de sesión funciona.</li>
      <li>Los eventos y las reseñas funcionan.</li>
      <li>Se puede acceder al panel administrativo.</li>
    </ul>
  </section>
</div>

<!-- MANUAL 3 -->
<div class="panel" id="administracion" role="tabpanel" aria-labelledby="t-administracion" hidden>
  <h2>Configuración y administración</h2>
  <p class="lead">Para el administrador de FestiNet: tareas de mantenimiento y supervisión del sistema.</p>

  <section>
    <h3>Administración mediante Webmin</h3>
    <p>La administración principal del servidor se hace desde Webmin:</p>
    <div class="code"><pre>https://192.168.2.2:10000</pre><button class="copy">Copiar</button></div>
    <p>Desde este panel puedes supervisar recursos, gestionar usuarios, administrar servicios y revisar configuraciones.</p>
  </section>

  <section>
    <h3>Gestión de usuarios</h3>
    <p>La aplicación usa control de acceso basado en roles.</p>
    <div class="roles">
      <div class="role"><h4>Artista</h4><ul><li>Consulta eventos.</li><li>Solicita participación.</li></ul></div>
      <div class="role"><h4>Local</h4><ul><li>Crea eventos.</li><li>Gestiona actuaciones.</li></ul></div>
      <div class="role"><h4>Administrador</h4><ul><li>Gestiona usuarios.</li><li>Supervisa el sistema.</li></ul></div>
    </div>
  </section>

  <section>
    <h3>Gestión de seguridad</h3>
    <ul class="check">
      <li>Gestión de roles y permisos.</li>
      <li>Protección de sesiones PHP.</li>
      <li>Validación de formularios.</li>
      <li>Prevención de registros duplicados.</li>
      <li>Cifrado de contraseñas mediante bcrypt.</li>
      <li>HTTPS mediante certificado SSL autofirmado.</li>
      <li>Firewall UFW.</li>
    </ul>
  </section>

  <section>
    <h3>Configuración del firewall</h3>
    <p>Solo están habilitados los puertos necesarios.</p>
    <div class="tw"><table>
      <thead><tr><th>Puerto</th><th>Servicio</th></tr></thead>
      <tbody>
        <tr><td>22/TCP</td><td>SSH</td></tr>
        <tr><td>80/TCP</td><td>HTTP</td></tr>
        <tr><td>443/TCP</td><td>HTTPS</td></tr>
        <tr><td>10000/TCP</td><td>Webmin</td></tr>
      </tbody>
    </table></div>
  </section>

  <section>
    <h3>Copias de seguridad</h3>
    <p>La aplicación tiene copias de seguridad periódicas de PostgreSQL para evitar la pérdida de datos, recuperar información tras incidencias y garantizar la continuidad del servicio.</p>
  </section>

  <section>
    <h3>Supervisión de servicios</h3>
    <div class="code"><pre>sudo systemctl status apache2
sudo systemctl status postgresql
sudo systemctl status webmin</pre><button class="copy">Copiar</button></div>
  </section>

  <section>
    <h3>Actuación ante incidencias</h3>
    <ol class="steps">
      <li><div>Revisa los registros de Apache, PHP y PostgreSQL.</div></li>
      <li><div>Comprueba el estado de los servicios.</div></li>
      <li><div>Restaura copias de seguridad si es necesario.</div></li>
      <li><div>Aplica la corrección correspondiente.</div></li>
      <li><div>Verifica de nuevo el funcionamiento.</div></li>
    </ol>
  </section>

  <section>
    <h3>Mejoras futuras</h3>
    <div class="note"><ul class="check">
      <li>Docker para contenerizar los servicios.</li>
      <li>Separar la base de datos y el servidor web.</li>
      <li>Certificados SSL de Let’s Encrypt.</li>
      <li>Dominio propio.</li>
      <li>Sistema de venta de entradas online.</li>
    </ul></div>
  </section>
</div>

</main>

<footer>FestiNet · Documentación del proyecto ASIR</footer>

<script>
(function(){
  var tabs=[].slice.call(document.querySelectorAll('.tab'));
  function show(id,push){
    if(!document.getElementById(id)) id='usuario';
    tabs.forEach(function(t){
      var on=t.getAttribute('aria-controls')===id;
      t.setAttribute('aria-selected',on);
      document.getElementById(t.getAttribute('aria-controls')).hidden=!on;
    });
    if(push) history.replaceState(null,'','#'+id);
  }
  tabs.forEach(function(t){t.addEventListener('click',function(){
    show(t.getAttribute('aria-controls'),true);
    window.scrollTo({top:document.querySelector('.tabs').offsetTop,behavior:'smooth'});
  })});
  window.addEventListener('hashchange',function(){show(location.hash.slice(1))});
  show(location.hash.slice(1));
  document.querySelectorAll('.copy').forEach(function(b){
    b.addEventListener('click',function(){
      var txt=b.previousElementSibling.textContent;
      var done=function(){b.textContent='¡Copiado!';setTimeout(function(){b.textContent='Copiar'},1500)};
      if(navigator.clipboard){navigator.clipboard.writeText(txt).then(done)}
    });
  });
})();
</script>
</body>
</html>
